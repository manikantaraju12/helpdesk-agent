# =============================================
# IT Helpdesk Agent — Environment Configuration
# =============================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.

# ----------------------------
# LLM Provider (OpenAI)
# ----------------------------
# Your OpenAI API key. Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# The OpenAI model used for generation and topic classification.
# Recommended: gpt-4o-mini (fast, cheap) or gpt-4o (higher quality)
OPENAI_MODEL=gpt-4o-mini

# ----------------------------
# Context Engine Configuration
# ----------------------------
# Maximum number of tokens allowed in the `recent` message array.
# Oldest messages are FIFO-evicted when this limit is exceeded.
# Pinned facts are NEVER evicted regardless of this setting.
# Set low (e.g., 100) for evaluation/testing to force eviction.
TOKEN_BUDGET_LIMIT=4000

# ----------------------------
# Server Configuration
# ----------------------------
# Host and port for the FastAPI server
HOST=0.0.0.0
PORT=8000
